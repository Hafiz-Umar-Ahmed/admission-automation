# ---- Copy to .env and fill in. NEVER commit the real .env ----

# Public domain that points at your server (no https://, no trailing slash)
DOMAIN=n8n.clientdomain.com

# Postgres (n8n database)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=n8n

# Encrypts credentials stored in n8n. Back this up: losing it makes credentials unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_long_random_hex

# Signs Accept/Reject links (HMAC-SHA256). Same value is read by every Crypto node.
# Generate with: openssl rand -hex 32
LINK_SECRET=change_me_long_random_hex

# Timezone for timestamps and schedules
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi
